# ============================================================================
# Empório da Música — Configuração do Agente de Atendimento (AI Engineer)
# ============================================================================

# Provedor de LLM: "gemini" | "openai" | "groq" | "ollama" | "local" (auto-detecta se "auto")
LLM_PROVIDER=auto

# Modelo específico (opcional — se vazio, usa o padrão recomendado do provedor):
# - gemini: gemini-2.5-flash
# - openai: gpt-4o-mini
# - groq:   llama-3.3-70b-versatile
# - ollama: llama3.1
LLM_MODEL=

# Chaves de API (preencha apenas a do provedor escolhido)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# URL customizada para provedores OpenAI-compatíveis (ex.: Ollama, OpenRouter, vLLM)
OPENAI_BASE_URL=

# Temperatura do modelo (recomendado: 0.1 a 0.3 para maior fidelidade aos dados)
LLM_TEMPERATURE=0.2

# Data de referência para simulação de prazos de pedidos/devoluções (YYYY-MM-DD)
# Os pedidos da base de dados ocorrem até 2026-03-22; usamos 2026-03-23 como padrão
# para permitir simulações realistas de pedidos recentes, enviados e entregues.
REFERENCE_DATE=2026-03-23

# Caminho do banco de histórico de conversas SQLite
CHAT_HISTORY_DB=data/chat_history.db
